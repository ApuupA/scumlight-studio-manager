# Copy this file to ".env" (next to docker-compose.yml) and change the values.
# docker compose reads it automatically. ".env" is ignored by git - never commit real passwords.

DB_PASSWORD=change-me
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-too
OWNER_NAME=Your Name

# pgAdmin (database browser on http://localhost:5050)
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me-as-well

# Port of the app on the host - change it if 8080 is already taken (e.g. by Nextcloud)
WEB_PORT=8080

# Proxies in front of the API: 1 = only the web container (local), 2 = with an HTTPS proxy in front (server).
# Needed so the login limit (10 attempts / 15 minutes) counts per browser and not for everyone together.
PROXY_COUNT=1
